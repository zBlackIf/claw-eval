# Base image via DaoCloud mirror (domestic acceleration).
# Override at build time if needed:
#   docker build --build-arg REGISTRY=docker.io -f Dockerfile.agent .
ARG REGISTRY=docker.m.daocloud.io
FROM ${REGISTRY}/python:3.11-slim

# Pass host proxy into build (auto-inherited from environment via build script)
ARG http_proxy
ARG https_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY

WORKDIR /workspace

# Switch apt to USTC mirror (domestic acceleration)
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/* 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true

# System packages for media processing
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Install sandbox server dependencies.
# v0.37.3 ark overlay: keep the index configurable so local smoke runs are not
# blocked when a regional mirror is stale or returns transient 403s.
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST=
COPY requirements-sandbox-server.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt \
        -i "${PIP_INDEX_URL}" \
        $(if [ -n "${PIP_TRUSTED_HOST}" ]; then printf '%s' "--trusted-host ${PIP_TRUSTED_HOST}"; fi) \
        --no-cache-dir \
    && rm /tmp/requirements.txt

# Only copy the sandbox server (not the full claw_eval framework)
COPY src/claw_eval/sandbox/ /opt/sandbox/

# Playwright + Chromium for browser screenshot/recording support.
# v0.50.11 ark overlay: the chromium binary download is gated behind a build arg.
# Some deploy hosts (e.g. kris) cannot reach the cdn.playwright.dev download
# redirect target over IPv4 *or* IPv6 (`connect EADDRNOTAVAIL <ipv6>:443`,
# IPv4 redirect times out), which loops the browser download forever. Default
# stays 1 (install chromium) so canonical builds are unchanged; pass
# --build-arg INSTALL_PLAYWRIGHT_BROWSER=0 on network-restricted hosts to ship
# the playwright python package without the browser binary (PDF/OCR/media tasks
# are unaffected; browser-screenshot tasks need the binary added separately).
ARG INSTALL_PLAYWRIGHT_BROWSER=1
RUN pip install playwright --no-cache-dir \
        -i "${PIP_INDEX_URL}" \
        $(if [ -n "${PIP_TRUSTED_HOST}" ]; then printf '%s' "--trusted-host ${PIP_TRUSTED_HOST}"; fi) \
    && if [ "${INSTALL_PLAYWRIGHT_BROWSER}" = "1" ]; then \
           NODE_OPTIONS="--dns-result-order=ipv4first" playwright install --with-deps chromium; \
       else \
           echo "[ark v0.50.11] Skipping chromium browser download (INSTALL_PLAYWRIGHT_BROWSER=0)"; \
       fi

EXPOSE 8080
ENTRYPOINT ["python", "/opt/sandbox/server.py", "--port", "8080"]
