<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.external.mapper.MesTransferCodeDataMapper">

    <sql id="Base_Column_List">
        id, transfer_code, product_code, batch_no, code_content, code_type, status, create_time
    </sql>

    <select id="selectByTransferCode" resultType="cn.iocoder.yudao.module.external.domain.MesTransferCodeData">
        SELECT <include refid="Base_Column_List"/>
        FROM mes_transfer_code_data
        WHERE transfer_code = #{transferCode}
    </select>

</mapper>
