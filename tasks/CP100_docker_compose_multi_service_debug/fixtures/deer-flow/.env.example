# Deer Flow Configuration
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# LangGraph Config
LANGGRAPH_API_URL=http://localhost:2024

# Search Provider
TAVILY_API_KEY=tvly-xxxxx

# Database
DATABASE_URL=sqlite:///./data/deer_flow.db

# Kubeconfig - BUG: points to directory, not file
KUBECONFIG_PATH=/root/.kube/config

# DEER_FLOW_ROOT - required by provisioner
# BUG: not set, causes RuntimeError on provisioner startup
# DEER_FLOW_ROOT=/app
