FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# BUG: DEER_FLOW_ROOT not set
# BUG: LANGGRAPH_API_URL should use localhost since it's the same container? No - it's separate service

EXPOSE 2024

CMD ["uvicorn", "deer_flow.api:app", "--host", "0.0.0.0", "--port", "2024"]
