{
  "app": {
    "name": "AI-GS Trading Dashboard",
    "version": "1.5.3",
    "port": 8080
  },
  "ai": {
    "default_model": "doubao-pro-32k",
    "system_prompt": "You are a helpful trading analysis assistant.",
    "max_tokens": 4096,
    "temperature": 0.7
  },
  "modules": {
    "thread_analysis": {
      "enabled": true,
      "data_sources": ["akshare", "tushare"]
    },
    "sentiment_analysis": {
      "enabled": true,
      "sources": ["xueqiu", "eastmoney"]
    },
    "simulated_trading": {
      "enabled": false,
      "initial_capital": 1000000
    }
  },
  "frontend": {
    "theme": "dark",
    "language": "en",
    "auto_refresh_interval": 30
  },
  "rules": []
}
